# ==========================================
# Bench - Ortam Değişkenleri Şablonu (Root)
# ==========================================
# Bu dosyayı kopyalayarak 'apps/api/.env' oluşturabilirsiniz:
# cp .env.example apps/api/.env

# API Sunucu Ayarları
PORT=8787
HOST=127.0.0.1

# Harici Motor Yolları (PATH üzerinde tanımlıysa varsayılanlar yeterlidir)
GHOSTSCRIPT_BIN=gs
# MARKITDOWN_BIN=.venv-markitdown/bin/markitdown

# Güvenlik & Tehdit İstihbaratı (Opsiyonel)
# VirusTotal Community API Anahtarı (https://www.virustotal.com/gui/my-apikey)
# Belirtilmezse varsayılan açık CIRCL Hashlookup API kullanılır.
VIRUSTOTAL_API_KEY=

# Yükleme & İşlem Güvenlik Sınırları
MAX_UPLOAD_BYTES=134217728 # 128 MB
MAX_UPLOAD_FILES=20
MAX_DATA_INPUT_BYTES=10485760 # 10 MB

# Kuyruk & Eşzamanlı İşlem Yöneticisi
MAX_CONCURRENT_JOBS=2
MAX_QUEUED_JOBS=20
JOB_QUEUE_TIMEOUT_MS=30000
COMPRESSION_TIMEOUT_MS=120000
MARKDOWN_TIMEOUT_MS=120000

# Frontend için (apps/web/.env.local içine yazılabilir)
BENCH_API_ORIGIN=http://127.0.0.1:8787
