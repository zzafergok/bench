# ==========================================
# Bench API - Ortam Değişkenleri Şablonu
# ==========================================
# Bu dosyayı kopyalayarak '.env' adıyla kaydedin:
# cp .env.example .env

# Sunucu Ayarları
PORT=8787
HOST=127.0.0.1

# Harici Araç Yolları (Varsayılan olarak PATH veya yerel venv kullanılır)
GHOSTSCRIPT_BIN=gs
# MARKITDOWN_BIN=/path/to/venv/bin/markitdown

# Güvenlik & Tehdit İstihbaratı (Opsiyonel)
# VirusTotal Free Community API Key (https://www.virustotal.com/gui/my-apikey)
# Tanımlanmazsa varsayılan olarak ücretsiz CIRCL Hashlookup API kullanılır.
VIRUSTOTAL_API_KEY=

# Yükleme & İşlem Sınırları
MAX_UPLOAD_BYTES=134217728 # 128 MB
MAX_UPLOAD_FILES=20
MAX_DATA_INPUT_BYTES=10485760 # 10 MB

# Eşzamanlı İş Kuyruğu Ayarları
MAX_CONCURRENT_JOBS=2
MAX_QUEUED_JOBS=20
JOB_QUEUE_TIMEOUT_MS=30000
COMPRESSION_TIMEOUT_MS=120000
MARKDOWN_TIMEOUT_MS=120000
